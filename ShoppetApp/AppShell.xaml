<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ShoppetApp.Pages"
       x:Class="ShoppetApp.AppShell"
       FlyoutBehavior="Disabled"
       Shell.TabBarIsVisible="False"
       Shell.NavBarIsVisible="False"
       Shell.BackgroundColor="{StaticResource AppBackground}">

    <TabBar Route="main">
        <ShellContent Title="Home"
                      Route="home"
                      ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="Pets"
                      Route="pets"
                      ContentTemplate="{DataTemplate pages:PetsListPage}" />
        <ShellContent Title="Marketplace"
                      Route="shop"
                      ContentTemplate="{DataTemplate pages:ShopPage}" />
        <ShellContent Title="Community"
                      Route="community"
                      ContentTemplate="{DataTemplate pages:CommunityPage}" />
        <ShellContent Title="Profile"
                      Route="profile"
                      ContentTemplate="{DataTemplate pages:ProfilePage}" />
    </TabBar>

</Shell>