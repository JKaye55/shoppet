<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShoppetApp.Controls.HeaderView">
    <Grid Padding="20,14,20,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Border WidthRequest="36"
                HeightRequest="36"
                StrokeThickness="0"
                BackgroundColor="{StaticResource Primary10}"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Image Source="shoppetlogo.png"
                   HeightRequest="22"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
            <Label Text="Shoppet Care"
                   FontFamily="NunitoExtraBold"
                   FontSize="16"
                   TextColor="{StaticResource SecondaryFg}" />
            <Label Text="Pet health, simply kept"
                   FontFamily="Nunito"
                   FontSize="11"
                   TextColor="{StaticResource NavMuted}" />
        </VerticalStackLayout>
        
        <Grid Grid.Column="2" VerticalOptions="Center">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="1"
                    Stroke="{StaticResource Secondary10}"
                    BackgroundColor="{StaticResource CardBg}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMessagesClicked" />
                </Border.GestureRecognizers>
                <Path Aspect="Uniform"
                      HeightRequest="20"
                      WidthRequest="20"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Fill="{StaticResource SecondaryFg}"
                      Data="M20,2H4C2.9,2 2,2.9 2,4V22L6,18H20C21.1,18 22,17.1 22,16V4C22,2.9 21.1,2 20,2Z" />
            </Border>
            
            <Border WidthRequest="18"
                    HeightRequest="18"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,-4,-4,0"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <Label Text="{Binding UnreadMessagesCount}"
                       FontFamily="NunitoBold"
                       FontSize="10"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentView>


