<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             x:Class="ShoppetApp.Pages.HealthLogFormPage"
             x:DataType="vm:HealthLogFormViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,24,16,32">
            <!-- Header Row -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource BodyText}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                </Border>
                <Label Grid.Column="1" Text="{Binding Title}" FontFamily="NunitoBold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource BodyText}" BackgroundColor="Transparent" />
                <Button Grid.Column="2" Text="Save" FontFamily="NunitoBold" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>

            <VerticalStackLayout Spacing="12">
                <!-- Type Selection Picker -->
                <Label Text="Record Type" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Picker ItemsSource="{Binding TypeOptions}" 
                            SelectedItem="{Binding LogType}" ItemDisplayBinding="{Binding .}" 
                            Title="Select Type" 
                            TitleColor="Gray"
                            TextColor="Black" BackgroundColor="Transparent" 
                            HeightRequest="44" />
                </Border>

                <Label Text="Common Record" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Picker ItemsSource="{Binding CommonRecordOptions}"
                            SelectedItem="{Binding SelectedCommonRecord}"
                            Title="Choose a common record"
                            TitleColor="{StaticResource Secondary}"
                            TextColor="{StaticResource BodyText}"
                            HeightRequest="44" />
                </Border>

                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsCustomRecordName}">
                    <Label Text="Record Name *" FontFamily="NunitoSemiBold" FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding Name}" Placeholder="Enter a custom record name" MaxLength="80" HeightRequest="52" />
                    </Border>
                    <Label Text="2–80 characters" FontSize="11" TextColor="{StaticResource Secondary}" />
                </VerticalStackLayout>

                <!-- ================== VACCINE SECTION ================== -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsVaccine}">
                    <Label Text="Date Administered" FontFamily="NunitoSemiBold" FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <DatePicker Date="{Binding DateAdministered}" Format="MMMM d, yyyy" TextColor="Black" BackgroundColor="Transparent" HeightRequest="44" />
                    </Border>

                    <Label Text="Validity Interval" FontFamily="NunitoSemiBold" FontSize="13" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Entry Text="{Binding ValidityIntervalText}" Keyboard="Numeric" Placeholder="e.g. 1" HeightRequest="52" />
                        </Border>
                        <Border Grid.Column="1" Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Picker ItemsSource="{Binding ValidityUnitOptions}" 
                                    SelectedItem="{Binding ValidityUnit}" ItemDisplayBinding="{Binding .}" 
                                    Title="Unit"
                                    TitleColor="Gray"
                                    TextColor="Black" BackgroundColor="Transparent" 
                                    HeightRequest="44" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- ================== MEDICATION SECTION ================== -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsMedication}">
                    <Label Text="Time Started" FontFamily="NunitoSemiBold" FontSize="13" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <DatePicker Date="{Binding TimeStartedDate}" Format="MMM d, yyyy" TextColor="Black" BackgroundColor="Transparent" HeightRequest="44" />
                        </Border>
                        <Border Grid.Column="1" Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <TimePicker Time="{Binding TimeStartedTime}" Format="h:mm tt" TextColor="Black" BackgroundColor="Transparent" HeightRequest="44" HorizontalOptions="Center" />
                        </Border>
                    </Grid>

                    <Label Text="Interval (hours)" FontFamily="NunitoSemiBold" FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding MedicationIntervalHoursText}" Keyboard="Numeric" Placeholder="e.g. 8" HeightRequest="52" />
                    </Border>

                    <Label Text="Total Dosage (number of times)" FontFamily="NunitoSemiBold" FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding DosageTotalText}" Keyboard="Numeric" Placeholder="e.g. 14" HeightRequest="52" />
                    </Border>
                </VerticalStackLayout>

                <!-- ================== CHECKUP SECTION ================== -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsCheckup}">
                    <Label Text="Checkup Date" FontFamily="NunitoSemiBold" FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <DatePicker Date="{Binding CheckupDate}" Format="MMMM d, yyyy" TextColor="Black" BackgroundColor="Transparent" HeightRequest="44" />
                    </Border>

                    <Label Text="Attached Documents" FontFamily="NunitoSemiBold" FontSize="13" />
                    <Button Text="Attach Document / Photo" Command="{Binding PickDocumentCommand}" BackgroundColor="{StaticResource Secondary10}" TextColor="{StaticResource Primary}" CornerRadius="16" HeightRequest="44" />

                    <CollectionView ItemsSource="{Binding DocumentPathsList}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                    <Label Text="{Binding .}" VerticalOptions="Center" LineBreakMode="TailTruncation" FontFamily="Nunito" FontSize="12" />
                                    <Border Grid.Column="1" WidthRequest="32" HeightRequest="32" BackgroundColor="Transparent" StrokeThickness="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HealthLogFormViewModel}}, Path=RemoveDocumentCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource StatusOverdue}" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ================== NEXT DUE DATE ================== -->
                <Label Text="Next Due Date" FontFamily="NunitoSemiBold" FontSize="13" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <DatePicker Date="{Binding DueDate}" Format="MMM d, yyyy" TextColor="Black" BackgroundColor="Transparent" HeightRequest="44" />
                    </Border>
                    <Border Grid.Column="1" Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <TimePicker Time="{Binding DueTime}" Format="h:mm tt" TextColor="Black" BackgroundColor="Transparent" HeightRequest="44" HorizontalOptions="Center" />
                    </Border>
                </Grid>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,12,0,0">
                    <CheckBox IsChecked="{Binding Completed}" Color="{StaticResource Primary}" />
                    <Label Text="Mark as Permanently Completed" FontFamily="Nunito" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button Text="Save Record" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" HeightRequest="52" CornerRadius="24" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryFg}" FontFamily="NunitoBold" Margin="0,24,0,0" />
            <Button Text="Delete Record" IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="Transparent" TextColor="{StaticResource StatusOverdue}" FontFamily="Nunito" FontSize="14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>