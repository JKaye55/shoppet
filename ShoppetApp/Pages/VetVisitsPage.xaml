<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ShoppetApp.Pages.VetVisitsPage" Title="Personal vet reminders" BackgroundColor="#fdfcf9">
 <ScrollView><VerticalStackLayout Padding="24" Spacing="14"><Label Text="Keep their care on schedule." FontFamily="NunitoExtraBold" FontSize="26" TextColor="#204d4c"/><Label Text="Personal reminders for visits you arrange with your veterinarian." TextColor="#708078"/><Picker x:Name="Pets" Title="Choose a pet" ItemDisplayBinding="{Binding Name}"/><Entry x:Name="Clinic" Placeholder="Vet / clinic name" MaxLength="150"/><DatePicker x:Name="Date"/><TimePicker x:Name="Time"/><Entry x:Name="Purpose" Placeholder="Purpose" MaxLength="150"/><Editor x:Name="Notes" Placeholder="Notes" AutoSize="TextChanges" MaxLength="1000"/><HorizontalStackLayout><CheckBox x:Name="Done"/><Label Text="Completed" VerticalOptions="Center"/></HorizontalStackLayout><Button Text="Save reminder" Clicked="Save" BackgroundColor="#246e6d" TextColor="White" CornerRadius="20"/><Button Text="Clear form" Clicked="Clear" BackgroundColor="#edf5f0" TextColor="#204d4c"/><Label Text="Your reminders" FontFamily="NunitoBold" FontSize="20"/><VerticalStackLayout x:Name="Rows" Spacing="14"/></VerticalStackLayout></ScrollView>
</ContentPage>
