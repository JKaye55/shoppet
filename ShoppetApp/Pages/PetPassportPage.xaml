<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ShoppetApp.Models"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             x:Class="ShoppetApp.Pages.PetPassportPage"
             x:DataType="vm:PetPassportViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">
    <Grid RowDefinitions="Auto,*">
        <!-- Hero photo -->
        <Grid Grid.Row="0" HeightRequest="264">
            <Image Source="{Binding Pet.PhotoUrl, Converter={StaticResource UrlToImageSourceConverter}}"
                   Aspect="AspectFill"
                   HeightRequest="264" />
            <BoxView VerticalOptions="Fill">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="{StaticResource Black60}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="0.6" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            <Grid Padding="16,48,16,16" ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="‹"
                        FontSize="22"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        BackgroundColor="{StaticResource White20}"
                        TextColor="White"
                        Command="{Binding GoBackCommand}" />
                <Button Grid.Column="2"
                        Text="Edit"
                        FontSize="16"
                        WidthRequest="36"
                        HeightRequest="36"
                        CornerRadius="18"
                        Padding="0"
                        BackgroundColor="{StaticResource White20}"
                        TextColor="White"
                        Command="{Binding EditPetCommand}" />
            </Grid>
            <VerticalStackLayout VerticalOptions="End" Padding="16,0,16,16" Spacing="4">
                <Label Text="{Binding Pet.Name}"
                       FontFamily="NunitoExtraBold"
                       FontSize="24"
                       TextColor="White" />
                <Label Text="{Binding Pet.Breed}"
                       FontFamily="Nunito"
                       FontSize="14"
                       TextColor="{StaticResource White70}" />
            </VerticalStackLayout>
        </Grid>

        <Border Grid.Row="1"
                IsVisible="{Binding HasLoadError}"
                Margin="24"
                Padding="20"
                BackgroundColor="{StaticResource CardBg}"
                Stroke="{StaticResource StatusOverdue}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                VerticalOptions="Center"
                ZIndex="20">
            <VerticalStackLayout Spacing="10">
                <Label Text="Pet data could not be loaded"
                       FontFamily="NunitoBold"
                       FontSize="18"
                       TextColor="{StaticResource BodyText}"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding LoadErrorMessage}"
                       FontSize="13"
                       TextColor="{StaticResource NavMuted}"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Retry"
                        Command="{Binding RetryCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontFamily="NunitoBold"
                        CornerRadius="18"/>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Age / Weight tiles -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource Highlight30}"
                            StrokeThickness="0"
                            Padding="12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="AGE" FontFamily="Nunito" FontSize="10" TextColor="{StaticResource Primary}" />
                            <Label FontFamily="NunitoExtraBold" FontSize="18" TextColor="{StaticResource Primary}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} years">
                                        <Binding Path="Pet.AgeYears" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource Accent30}"
                            StrokeThickness="0"
                            Padding="12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="WEIGHT" FontFamily="Nunito" FontSize="10" TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding Pet.Weight}" FontFamily="NunitoExtraBold" FontSize="18" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Digital Pet ID -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        Stroke="{StaticResource Secondary20}"
                        StrokeThickness="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 22"
                        IsVisible="{Binding HasPetId}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border WidthRequest="112" HeightRequest="112"
                                BackgroundColor="White"
                                Stroke="{StaticResource Secondary20}"
                                StrokeThickness="1"
                                Padding="6"
                                StrokeShape="RoundRectangle 16">
                            <Image Source="{Binding QrImageUrl}" Aspect="AspectFit" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="DIGITAL PET ID" FontFamily="NunitoBold" FontSize="11" TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding Pet.CardId}" FontFamily="NunitoExtraBold" FontSize="20" TextColor="{StaticResource BodyText}" />
                            <Label Text="{Binding PublicPetIdUrl}" FontSize="10" TextColor="{StaticResource NavMuted}" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                <Button Text="Copy Link" Command="{Binding CopyPetIdCommand}" FontSize="11" HeightRequest="34" Padding="12,0" CornerRadius="16" BackgroundColor="{StaticResource Primary10}" TextColor="{StaticResource Primary}" />
                                <Button Text="Share" Command="{Binding SharePetIdCommand}" FontSize="11" HeightRequest="34" Padding="12,0" CornerRadius="16" BackgroundColor="{StaticResource Primary}" TextColor="White" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Two-tab pill toggle -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border x:Name="HealthTabPill" Grid.Column="0" Padding="0,10" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHealthTabTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="HealthTabLabel" Text="Health Records" FontFamily="NunitoBold" FontSize="13" HorizontalOptions="Center" />
                    </Border>
                    <Border x:Name="FoodTabPill" Grid.Column="1" Padding="0,10" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFoodTabTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="FoodTabLabel" Text="Food Tracker" FontFamily="NunitoBold" FontSize="13" HorizontalOptions="Center" />
                    </Border>
                </Grid>

                <!-- ── Health Records section ──────────────────────────────── -->
                <VerticalStackLayout x:Name="HealthSection" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Health Records"
                               FontFamily="NunitoBold" FontSize="16"
                               TextColor="{StaticResource SecondaryFg}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Add"
                                FontFamily="NunitoBold" FontSize="13"
                                HeightRequest="36" Padding="16,0" CornerRadius="20"
                                BackgroundColor="{StaticResource Primary10}"
                                TextColor="{StaticResource Primary}"
                                Command="{Binding AddLogCommand}" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding HealthLogs}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:HealthLog">
                                <Border Margin="0,4" Padding="12"
                                        BackgroundColor="{StaticResource CardBg}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{StaticResource Black60}" Offset="0,2" Radius="8" Opacity="0.1" />
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="10">
                                        <!-- Row 1: Name + Type badge + Edit button -->
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                <Label Text="{Binding Name}"
                                                       FontFamily="NunitoBold" FontSize="15"
                                                       TextColor="{StaticResource SecondaryFg}" />
                                                <Label Text="{Binding DosageRemaining, StringFormat='Dosage Remaining: {0}'}" 
                                                       FontFamily="Nunito" FontSize="12" TextColor="{StaticResource NavMuted}" 
                                                       IsVisible="{Binding IsMedication}" />
                                                <Label Text="Checkup Documents Attached" 
                                                       FontFamily="Nunito" FontSize="12" TextColor="{StaticResource NavMuted}" 
                                                       IsVisible="{Binding IsCheckup}" />
                                            </VerticalStackLayout>
                                            
                                            <!-- Type pill -->
                                            <Border Grid.Column="1" Padding="8,4" BackgroundColor="{Binding Type, Converter={StaticResource HealthTypeBgConverter}}" StrokeThickness="0" VerticalOptions="Start">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                <Label Text="{Binding Type, Converter={StaticResource HealthTypeLabelConverter}}" FontFamily="NunitoBold" FontSize="11" TextColor="{Binding Type, Converter={StaticResource HealthTypeColorConverter}}" />
                                            </Border>
                                            
                                            <!-- Edit button -->
                                            <Button Grid.Column="2" Text="Edit" FontSize="13" WidthRequest="34" HeightRequest="34" CornerRadius="17" Padding="0" BackgroundColor="{StaticResource Secondary10}" TextColor="{StaticResource Primary}" VerticalOptions="Start" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PetPassportViewModel}}, Path=EditLogCommand}" CommandParameter="{Binding .}" />
                                        </Grid>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DocumentsList}">
                                            <BindableLayout.ItemTemplate><DataTemplate x:DataType="x:String"><Button Text="Open care document" FontSize="12" HeightRequest="36" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PetPassportViewModel}}, Path=OpenDocumentCommand}" CommandParameter="{Binding .}" /></DataTemplate></BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <!-- Row 2: Schedule info -->
                                        <!-- Row 2: Schedule info -->
                                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding BaseDateDisplay, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                            <Label Text="Schedule" FontFamily="NunitoBold" FontSize="10" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                                            <Label Text="{Binding ., Converter={StaticResource HealthScheduleLabelConverter}}"
                                                   FontFamily="Nunito" FontSize="12"
                                                   TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <!-- Separator -->
                                        <BoxView HeightRequest="1" Color="{StaticResource Secondary10}" Margin="0,2" />

                                        <!-- Row 3: Status/Completed + Action Buttons -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                <!-- Next Timestamp -->
                                                <Label Text="{Binding NextDateFormatted, StringFormat='Next: {0}'}" 
                                                       FontFamily="NunitoSemiBold" FontSize="12" TextColor="{StaticResource Primary}" 
                                                       IsVisible="{Binding Completed, Converter={StaticResource InverseBoolConverter}}" />
                                                
                                                <!-- Status -->
                                                <HorizontalStackLayout Spacing="6" IsVisible="{Binding Completed, Converter={StaticResource InverseBoolConverter}}">
                                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{Binding Status, Converter={StaticResource StatusColorConverter}}" VerticalOptions="Center" />
                                                    <Label Text="{Binding Status, Converter={StaticResource StatusLabelConverter}}" FontFamily="Nunito" FontSize="12" TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                                </HorizontalStackLayout>
                                                
                                                <!-- Completed Label -->
                                                <Label Text="COMPLETED" FontFamily="NunitoBold" FontSize="12" TextColor="{StaticResource StatusHealthy}" IsVisible="{Binding Completed}" />
                                            </VerticalStackLayout>

                                            <!-- Completed Label (Visible when Completed = true) -->
                                            <Label Grid.Column="1" Text="Completed" FontFamily="NunitoBold" FontSize="12" TextColor="{StaticResource Success}" VerticalOptions="Center" IsVisible="{Binding Completed}" />
                                            <!-- Action buttons -->
                                            <HorizontalStackLayout Grid.Column="1" Spacing="6" IsVisible="{Binding Completed, Converter={StaticResource InverseBoolConverter}}">
                                                <Button Text="Complete" FontFamily="NunitoBold" FontSize="12" HeightRequest="36" Padding="12,0" CornerRadius="18" BackgroundColor="Transparent" TextColor="{StaticResource StatusOverdue}" VerticalOptions="Center" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PetPassportViewModel}}, Path=MarkCompletedCommand}" CommandParameter="{Binding .}" />
                                                <Button Text="Done" FontFamily="NunitoBold" FontSize="12" HeightRequest="36" Padding="12,0" CornerRadius="18" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryFg}" VerticalOptions="Center" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PetPassportViewModel}}, Path=MarkDoneCommand}" CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="No health records yet."
                           IsVisible="{Binding HealthLogs.Count, Converter={StaticResource CountToBoolConverter}, ConverterParameter=invert}"
                           FontFamily="Nunito" FontSize="14" TextColor="{StaticResource Secondary}"
                           HorizontalOptions="Center" Margin="0,24" />
                </VerticalStackLayout>

                <!-- ── Food Tracker section ───────────────────────────────── -->
                <VerticalStackLayout x:Name="FoodSection" Spacing="12" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Food Tracker"
                               FontFamily="NunitoBold" FontSize="16"
                               TextColor="{StaticResource SecondaryFg}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Add"
                                FontFamily="NunitoBold" FontSize="13"
                                HeightRequest="36" Padding="16,0" CornerRadius="20"
                                BackgroundColor="{StaticResource Primary10}"
                                TextColor="{StaticResource Primary}"
                                Command="{Binding AddFoodLogCommand}" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding FoodLogs}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FoodLog">
                                <Border Margin="0,4" Padding="14"
                                        BackgroundColor="{StaticResource CardBg}" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{StaticResource Black60}" Offset="0,2" Radius="8" Opacity="0.1" />
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="10">
                                        <!-- Row 1: Name + Interval badge + Edit button -->
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                <Label Text="{Binding FoodName}"
                                                       FontFamily="NunitoBold" FontSize="15"
                                                       TextColor="{StaticResource SecondaryFg}" />
                                                                                                <Label Text="{Binding AmountGrams, StringFormat='{0:G} g per serving'}"
                                                       FontFamily="Nunito" FontSize="12"
                                                       TextColor="{StaticResource NavMuted}" />
                                                <Label Text="{Binding Notes, StringFormat='&quot;{0}&quot;'}" 
                                                       IsVisible="{Binding HasNotes}"
                                                       FontFamily="Nunito" FontAttributes="Italic" FontSize="12" 
                                                       TextColor="{StaticResource NavMuted}" 
                                                       LineBreakMode="WordWrap"
                                                       Margin="0,2,0,0"/>
                                            </VerticalStackLayout>
                                            <!-- Interval pill -->
                                            <Border Grid.Column="1"
                                                    Padding="8,4"
                                                    BackgroundColor="{StaticResource Primary10}"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Start">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                <Label Text="{Binding ., Converter={StaticResource FeedingIntervalLabelConverter}}"
                                                       FontFamily="NunitoBold" FontSize="11"
                                                       TextColor="{StaticResource Primary}" />
                                            </Border>
                                            <!-- Edit button -->
                                            <Button Grid.Column="2"
                                                    Text="Edit"
                                                    FontSize="13"
                                                    WidthRequest="34" HeightRequest="34"
                                                    CornerRadius="17" Padding="0"
                                                    BackgroundColor="{StaticResource Secondary10}"
                                                    TextColor="{StaticResource Primary}"
                                                    VerticalOptions="Start"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PetPassportViewModel}}, Path=EditFoodLogCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>

                                        <!-- Row 2: Schedule info -->
                                        <!-- Row 2: Schedule info -->
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="Schedule" FontFamily="NunitoBold" FontSize="10" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                                            <Label Text="{Binding ., Converter={StaticResource LastFedLabelConverter}}"
                                                   FontFamily="Nunito" FontSize="12"
                                                   TextColor="{StaticResource Secondary}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!-- Separator -->
                                        <BoxView HeightRequest="1" Color="{StaticResource Secondary10}" Margin="0,2" />

                                        <!-- Row 3: Next Feeding + Done button -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                <!-- Next feeding time -->
                                                <Label Text="{Binding ., Converter={StaticResource NextFeedingLabelConverter}}"
                                                       FontFamily="NunitoSemiBold" FontSize="12"
                                                       TextColor="{StaticResource Primary}"
                                                       IsVisible="{Binding HasNextFeeding}" />
                                            </VerticalStackLayout>

                                            <!-- Done button -->
                                            <Button Grid.Column="1"
                                                    Text="Done"
                                                    FontFamily="NunitoBold"
                                                    FontSize="12"
                                                    HeightRequest="36"
                                                    Padding="12,0"
                                                    CornerRadius="18"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    TextColor="{StaticResource PrimaryFg}"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PetPassportViewModel}}, Path=MarkFedDoneCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="No food logs yet."
                           IsVisible="{Binding FoodLogs.Count, Converter={StaticResource CountToBoolConverter}, ConverterParameter=invert}"
                           FontFamily="Nunito" FontSize="14" TextColor="{StaticResource Secondary}"
                           HorizontalOptions="Center" Margin="0,24" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>






