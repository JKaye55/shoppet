<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" x:Name="ThisPage"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             xmlns:models="clr-namespace:ShoppetApp.Models"
             x:Class="ShoppetApp.Pages.PostSettingsPage"
             x:DataType="vm:PostSettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" BackgroundColor="{StaticResource AppBackground}" StrokeThickness="0" Padding="15,10">
            <HorizontalStackLayout Spacing="10">
                <Label Text="&#x25C0; Back" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" FontSize="16" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Post Settings" TextColor="{StaticResource SecondaryFg}" FontFamily="NunitoExtraBold" FontSize="18" VerticalOptions="Center" Margin="10,0,0,0"/>
            </HorizontalStackLayout>
        </Border>

        <RefreshView Grid.Row="1" Command="{Binding LoadMyPostsCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="0,0,0,20">
                    <Label Text="You haven't made any posts yet." HorizontalOptions="Center" VerticalOptions="Center" TextColor="#888" Margin="0,50,0,0" IsVisible="{Binding MyPosts.Count, Converter={StaticResource InvertedBoolConverter}}" />
                    
                    <CollectionView ItemsSource="{Binding MyPosts}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CommunityPost">
                                <Grid>
                                    <Border BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Margin="15,10" Padding="15">
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                                    <Label Text="{Binding Initials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" FontFamily="NunitoBold" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Label Text="{Binding AuthorName}" TextColor="{StaticResource BodyText}" FontFamily="NunitoBold" FontSize="16" />
                                                        <Label Text="{Binding PetName, StringFormat=' is with {0}'}" TextColor="#666666" FontSize="14" IsVisible="{Binding PetName, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding TimeAgo}" TextColor="#888888" FontSize="12" />
                                                </VerticalStackLayout>
                                                
                                                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Start">
                                                    <Button Text="&#x270E;" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" FontFamily="NunitoBold" Padding="0" HeightRequest="30" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PostSettingsViewModel}}, Path=EditPostActionCommand}" CommandParameter="{Binding .}" />
                                                    <Button Text="&#x1F5D1;" TextColor="{StaticResource StatusOverdue}" BackgroundColor="Transparent" FontFamily="NunitoBold" Padding="0" HeightRequest="30" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PostSettingsViewModel}}, Path=DeletePostActionCommand}" CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <Label Text="{Binding Content}" TextColor="{StaticResource BodyText}" FontSize="15" />

                                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always" IsVisible="{Binding HasImages}" HeightRequest="250" Margin="0,5">
                                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ImageList}" Spacing="5">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid WidthRequest="300" HeightRequest="250">
                                                                <Image Source="{Binding .}" Aspect="AspectFill" HeightRequest="250" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </HorizontalStackLayout>
                                            </ScrollView>

                                            <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                                                <Label Text="{Binding LikesCount, StringFormat='{0} Likes'}" TextColor="#666666" FontSize="13" />
                                                <Label Text="{Binding CommentsCount, StringFormat='{0} Comments'}" TextColor="#666666" FontSize="13" HorizontalOptions="End" />
                                            </HorizontalStackLayout>

                                            <BoxView HeightRequest="1" Color="{StaticResource Secondary30}" Margin="0,5" />

                                            <Grid ColumnDefinitions="*,*">
                                                <Button Grid.Column="0" Text="{Binding IsLikedByMe, Converter={StaticResource BoolToLikeTextConverter}}" 
                                                        TextColor="{Binding IsLikedByMe, Converter={StaticResource BoolToLikeColorConverter}}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PostSettingsViewModel}}, Path=ToggleLikeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="Transparent" FontFamily="NunitoBold" />
                                                <Button Grid.Column="1" Text="Comment" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" FontFamily="NunitoBold"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PostSettingsViewModel}}, Path=GoToPostDetailsCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>


                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>






