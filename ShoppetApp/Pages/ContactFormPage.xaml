<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             x:Class="ShoppetApp.Pages.ContactFormPage"
             x:DataType="vm:ContactFormViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,24,16,32">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseCommand}" /></Border.GestureRecognizers>
                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource SecondaryFg}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform"/>
                </Border>
                <Label Grid.Column="1" Text="{Binding Title}" FontFamily="NunitoBold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource SecondaryFg}" />
                <Button Grid.Column="2" Text="Save" FontFamily="NunitoBold" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>

            <VerticalStackLayout Spacing="12">
                <Label Text="Name / Clinic *" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Name}" MaxLength="80" Placeholder="Dr. Sarah Lee" HeightRequest="52" />
                </Border>

                <!-- Role Selection Picker -->
                <Label Text="Role / Description" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Picker ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding Role}" TextColor="{StaticResource SecondaryFg}" Title="Select Role" HeightRequest="44" />
                </Border>

                <Label Text="Phone Number *" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Phone}" Keyboard="Telephone" MaxLength="20" Placeholder="09123456789" HeightRequest="52" />
                </Border>

                <Label Text="Address (optional)" FontFamily="NunitoSemiBold" FontSize="13" />
                <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Address}" MaxLength="200" Placeholder="Optional address or clinic location" HeightRequest="52" />
                </Border>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding IsEmergency}" Color="{StaticResource StatusOverdue}" />
                    <Label Text="Emergency Contact" FontFamily="Nunito" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Button Text="Save Contact" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" HeightRequest="52" CornerRadius="24" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryFg}" FontFamily="NunitoBold" />
            <Button Text="Delete Contact" IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="Transparent" TextColor="{StaticResource StatusOverdue}" FontFamily="Nunito" FontSize="14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>