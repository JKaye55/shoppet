<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ShoppetApp.Controls"
             xmlns:models="clr-namespace:ShoppetApp.Models"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             x:Class="ShoppetApp.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">
    <Grid>
        <Grid RowDefinitions="Auto,*">
            <controls:HeaderView Grid.Row="0" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16" Padding="20,8,20,108">

                                        <!-- User Avatar & Name -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,16">
                        <Border WidthRequest="80"
                                HeightRequest="80"
                                BackgroundColor="{StaticResource Primary10}"
                                Stroke="{StaticResource Secondary}"
                                StrokeThickness="2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="40" />
                            </Border.StrokeShape>
                            <Grid>
                                <Label Text="&#x1F464;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding ProfileImageSource}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label Text="{Binding FullName}"
                                   FontFamily="NunitoExtraBold"
                                   FontSize="20"
                                   TextColor="{StaticResource SecondaryFg}"
                                   VerticalOptions="Center" />
                            
                        </HorizontalStackLayout>
                        <Button Text="Edit Profile" Command="{Binding EditProfileCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" Padding="0" HeightRequest="30" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- ==========================================
                         RBAC: ADMIN / BUSINESS OWNER CONTROL PANEL
                         ========================================== -->
                    <Border BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="0"
                            Padding="16"
                            IsVisible="{Binding IsAdmin}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="&#x2699; Admin Control Panel" FontFamily="NunitoBold" FontSize="14" TextColor="#1E2824"/>
                            <Button Text="Manage Platform Users &amp; Clinics" 
                                    BackgroundColor="#F7DD7D" TextColor="#16241F" FontAttributes="Bold" CornerRadius="12"
                                    Command="{Binding OpenAdminPanelCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="0"
                            Padding="16"
                            IsVisible="{Binding IsBusinessOwner}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="&#x1F3E5; Clinic / Vet Shop Management" FontFamily="NunitoBold" FontSize="14" TextColor="#1E2824"/>
                            <Button Text="Manage Counter Orders &amp; Inventory" 
                                    BackgroundColor="#5C766D" TextColor="White" FontAttributes="Bold" CornerRadius="12"
                                    Command="{Binding OpenBusinessPanelCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Emergency Contacts Section (Your Existing Code) -->
                    <Border BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Black60}" Offset="0,2" Radius="10" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Emergency Contacts"
                                       FontFamily="NunitoBold"
                                       FontSize="16"
                                       TextColor="{StaticResource SecondaryFg}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Add"
                                        FontFamily="NunitoBold"
                                        FontSize="13"
                                        HeightRequest="36"
                                        Padding="16,0"
                                        CornerRadius="20"
                                        BackgroundColor="{StaticResource Primary10}"
                                        TextColor="{StaticResource Primary}"
                                        Command="{Binding AddContactCommand}" />
                            </Grid>
                            <CollectionView ItemsSource="{Binding Contacts}" SelectionMode="None" MaximumHeightRequest="230">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Contact">
                                        <Border Margin="0"
                                                Padding="12"
                                                BackgroundColor="{Binding IsEmergency, Converter={StaticResource EmergencyBgConverter}}"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" BackgroundColor="Transparent" HorizontalOptions="Fill">
                                                    <VerticalStackLayout.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=ViewContactCommand}" CommandParameter="{Binding .}" />
                                                    </VerticalStackLayout.GestureRecognizers>
                                                    <Label Text="{Binding Name}"
                                                           FontFamily="NunitoBold"
                                                           FontSize="14"
                                                           TextColor="{Binding IsEmergency, Converter={StaticResource EmergencyTextConverter}}" />
                                                    <Label Text="{Binding Role}"
                                                           FontFamily="Nunito"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Secondary}" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Primary10}" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="20" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=EditContactCommand}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#x270F;" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Border Grid.Column="2" WidthRequest="40" HeightRequest="40" BackgroundColor="#1AFF3B30" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="20" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=DeleteContactCommand}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#x1F5D1;" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Border Grid.Column="3" WidthRequest="40" HeightRequest="40" BackgroundColor="{Binding IsEmergency, Converter={StaticResource EmergencyPhoneBgConverter}}" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="20" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=CallContactCommand}" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#x1F4DE;" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Settings & Local Shops Section -->
                    <Border BackgroundColor="{StaticResource CardBg}"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Black60}" Offset="0,2" Radius="10" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Settings &amp; Directory"
                                   FontFamily="NunitoBold"
                                   FontSize="16"
                                   TextColor="{StaticResource SecondaryFg}"
                                   Margin="0,0,0,8" />

                            <!-- Local Pet Shops Around Lipa Button Link -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Label Text="&#x1F4CD; Local Lipa Pet Shops &amp; Clinics" FontFamily="Nunito" VerticalOptions="Center" />
                                <Label Text="&#x276F;" FontSize="14" Grid.Column="1" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenLocalShopsCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />

                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Label Text="Post Settings (Edit/Delete Posts)" FontFamily="Nunito" VerticalOptions="Center" />
                                <Label Text="&#x276F;" FontSize="14" Grid.Column="1" VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenPostSettingsCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />
                            
                            <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                <Label Text="Account Settings" FontFamily="Nunito" VerticalOptions="Center" />
                                <Label Text="&#x276F;" FontSize="14" Grid.Column="1" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />

                            <HorizontalStackLayout Spacing="8" Padding="0,12">
                                <Label Text="&#x1F6AA;" FontSize="16" VerticalOptions="Center" />
                                <Label Text="Log Out"
                                       FontFamily="Nunito"
                                       TextColor="{StaticResource StatusOverdue}"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <controls:FloatingTabBar SelectedTab="profile"
                                 VerticalOptions="End" />

        <!-- Contact Detail Modal Overlay -->
        <Grid x:Name="ContactDetailModal" IsVisible="False" BackgroundColor="#99000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissContactModal" />
            </Grid.GestureRecognizers>
            <Border x:Name="ContactModalCard"
                    BackgroundColor="{StaticResource CardBg}"
                    StrokeThickness="0"
                    Margin="24,0"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill">
                <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnModalBodyTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <Grid HeightRequest="100" BackgroundColor="{StaticResource Primary}">
                        <Grid.Clip><RoundRectangleGeometry Rect="0,0,500,100" CornerRadius="28,28,0,0" /></Grid.Clip>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                            <Border WidthRequest="56" HeightRequest="56" BackgroundColor="#33FFFFFF" StrokeThickness="0" HorizontalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                                <Label x:Name="ModalContactInitial" Text="?" FontFamily="NunitoExtraBold" FontSize="24" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                        <Border x:Name="ModalEmergencyBadge" BackgroundColor="#FFDE03" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start" Margin="0,12,12,0" Padding="8,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Label Text="&#x26A0; Emergency" FontFamily="NunitoBold" FontSize="11" TextColor="#1A1A1A" />
                        </Border>
                    </Grid>
                    <VerticalStackLayout Padding="24,20,24,24" Spacing="16">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="ModalContactName" FontFamily="OutfitBold" FontSize="22" TextColor="{StaticResource SecondaryFg}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                            <Label x:Name="ModalContactRole" FontFamily="Nunito" FontSize="14" TextColor="{StaticResource Secondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource Primary10}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Label Text="&#x1F4DE;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Phone" FontFamily="NunitoBold" FontSize="12" TextColor="{StaticResource Secondary}" />
                                <Label x:Name="ModalContactPhone" FontFamily="Nunito" FontSize="15" TextColor="{StaticResource BodyText}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid x:Name="ModalAddressRow" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource Primary10}" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                <Label Text="&#x1F4CD;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Address" FontFamily="NunitoBold" FontSize="12" TextColor="{StaticResource Secondary}" />
                                <Label x:Name="ModalContactAddress" FontFamily="Nunito" FontSize="15" TextColor="{StaticResource BodyText}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                            <Button x:Name="ModalCallBtn" Grid.Column="0" Text="&#x1F4DE; Call" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="16" FontFamily="NunitoBold" FontSize="15" HeightRequest="48" Clicked="OnModalCallClicked" />
                            <Button Grid.Column="1" Text="Close" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource BodyText}" BorderColor="{StaticResource Secondary30}" BorderWidth="1" CornerRadius="16" FontFamily="NunitoBold" FontSize="15" HeightRequest="48" Clicked="OnDismissContactModal" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>







