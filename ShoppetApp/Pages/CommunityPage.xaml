<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             xmlns:controls="clr-namespace:ShoppetApp.Controls"
             x:Class="ShoppetApp.Pages.CommunityPage"
             Title="Community"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0">
            <controls:HeaderView />
            </VerticalStackLayout>

        <Grid Grid.Row="1">
            <RefreshView Command="{Binding LoadPostsCommand}" IsRefreshing="{Binding IsRefreshing}">
                <ScrollView>
                    <VerticalStackLayout Spacing="15" Padding="15,10,15,100">
                        <Border BackgroundColor="{StaticResource AppBackground}" StrokeThickness="0" Padding="5,5,5,5">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Shoppet Community" FontFamily="NunitoBold" FontSize="26" TextColor="{StaticResource BodyText}" />
                                <Label Text="Share stories, experiences, and helpful pet-care tips with fellow pet parents." TextColor="#666666" FontSize="14" />
                            </VerticalStackLayout>
                        </Border>
                        
                        <!-- What's on your mind? Section -->
                        <Border BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="15">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <!-- Profile Picture Placeholder -->
                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                    <Label Text="{Binding UserInitials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" FontFamily="NunitoBold" />
                                </Border>

                                <!-- Fake Input -->
                                <Border Grid.Column="1" BackgroundColor="{StaticResource AppBackground}" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="{StaticResource Secondary30}" Padding="15,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToCreatePostCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="What's on your mind?" TextColor="#888888" VerticalOptions="Center" FontSize="15" />
                                </Border>

                                <!-- Photo Icon -->
                                <Border Grid.Column="2" BackgroundColor="{StaticResource AppBackground}" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="{StaticResource Secondary30}">
                                    <Label Text="📷" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding GoToCreatePostCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Feed List -->
                        <CollectionView ItemsSource="{Binding Posts}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Margin="0,0,0,0" Padding="15">
                                        <VerticalStackLayout Spacing="12">
                                            <!-- Post Header -->
                                            <HorizontalStackLayout Spacing="10">
                                                <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                                    <Label Text="{Binding Initials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" FontFamily="NunitoBold" />
                                                </Border>
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Label Text="{Binding AuthorName}" TextColor="{StaticResource BodyText}" FontFamily="NunitoBold" FontSize="16" />
                                                        <Label Text="{Binding PetName, StringFormat=' is with {0}'}" TextColor="#666666" FontSize="14" IsVisible="{Binding PetName, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding TimeAgo}" TextColor="#888888" FontSize="12" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>

                                            <!-- Content -->
                                            <Label Text="{Binding Content}" TextColor="{StaticResource BodyText}" FontSize="15" />

                                            <!-- Attached Media -->
                                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always" IsVisible="{Binding HasImages}" HeightRequest="250" Margin="0,5">
                                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ImageList}" Spacing="5">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid WidthRequest="300" HeightRequest="250">
                                                                <Image Source="{Binding .}" Aspect="AspectFill" HeightRequest="250" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </HorizontalStackLayout>
                                            </ScrollView>

                                            <!-- Stats -->
                                            <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                                                <Label Text="{Binding LikesCount, StringFormat='{0} Likes'}" TextColor="#666666" FontSize="13" />
                                                <Label Text="{Binding CommentsCount, StringFormat='{0} Comments'}" TextColor="#666666" FontSize="13" HorizontalOptions="EndAndExpand" />
                                            </HorizontalStackLayout>

                                            <BoxView HeightRequest="1" Color="{StaticResource Secondary30}" Margin="0,5" />

                                            <!-- Actions -->
                                            <Grid ColumnDefinitions="*,*">
                                                <Button Grid.Column="0" Text="{Binding IsLikedByMe, Converter={StaticResource BoolToLikeTextConverter}}" 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CommunityViewModel}}, Path=ToggleLikeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        TextColor="{Binding IsLikedByMe, Converter={StaticResource BoolToLikeColorConverter}}"
                                                        BackgroundColor="Transparent" FontFamily="NunitoBold" />
                                                <Button Grid.Column="1" Text="🗨 Comment" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" FontFamily="NunitoBold"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CommunityViewModel}}, Path=GoToPostDetailsCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <!-- Navigation Bar placed here -->
            <controls:FloatingTabBar SelectedTab="community" VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>












