<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             xmlns:controls="clr-namespace:ShoppetApp.Controls"
             x:Class="ShoppetApp.Pages.CommunityPage"
             Title="Community"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,*">
        <controls:HeaderView Grid.Row="0" />

        <Grid Grid.Row="1">
            <RefreshView Command="{Binding RefreshCommand}"
                         IsRefreshing="{Binding IsRefreshing}"
                         IsVisible="{Binding ShowRankingsTab, Converter={StaticResource InverseBoolConverter}}"
                         RefreshColor="{StaticResource Primary}">
                <CollectionView ItemsSource="{Binding Posts}"
                                SelectionMode="None"
                                Margin="0"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout Padding="18,16,18,14" Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Shoppet Community"
                                           FontFamily="NunitoExtraBold"
                                           FontSize="27"
                                           TextColor="{StaticResource BodyText}" />
                                    <Label Text="Stories, tips, and everyday moments from pet parents."
                                           FontFamily="Nunito"
                                           FontSize="13"
                                           TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        BackgroundColor="{StaticResource Primary10}"
                                        Stroke="{StaticResource Primary20}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 21">
                                    <Path Data="{StaticResource IconCamera}"
                                          Fill="{StaticResource Primary}"
                                          WidthRequest="20"
                                          HeightRequest="20"
                                          Aspect="Uniform"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToCreatePostCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <Border BackgroundColor="{StaticResource CardBg}"
                                    Stroke="{StaticResource Secondary20}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    Padding="14">
                                <Border.Shadow>
                                    <Shadow Brush="#16000000" Offset="0,4" Radius="14" Opacity="0.16" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                    <Border WidthRequest="42"
                                            HeightRequest="42"
                                            BackgroundColor="{StaticResource Primary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 21">
                                        <Grid>
                                            <Label Text="{Binding UserInitials}"
                                                   TextColor="White"
                                                   FontFamily="NunitoBold"
                                                   FontSize="15"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding UserProfilePicture, Converter={StaticResource Base64ToImageSourceConverter}}"
                                                   Aspect="AspectFill" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1"
                                            BackgroundColor="{StaticResource Secondary05}"
                                            Stroke="{StaticResource Secondary20}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 18"
                                            Padding="14,0">
                                        <Label Text="Share something with the community..."
                                               FontSize="14"
                                               TextColor="{StaticResource Gray500}"
                                               VerticalOptions="Center" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding GoToCreatePostCommand}" />
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Button Grid.Column="2"
                                            Text="Post"
                                            Command="{Binding GoToCreatePostCommand}"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            FontFamily="NunitoBold"
                                            FontSize="13"
                                            CornerRadius="17"
                                            HeightRequest="42"
                                            Padding="16,0" />
                                </Grid>
                            </Border>

                            <!-- Feed / Rankings Segmented Switch -->
                            <Border BackgroundColor="{StaticResource Secondary10}"
                                    Stroke="{StaticResource Secondary20}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="4">
                                <Grid ColumnDefinitions="*,*">
                                    <Border BackgroundColor="{Binding FeedTabBg}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13"
                                            Padding="0,8">
                                        <Label Text="Community Feed"
                                               FontFamily="NunitoBold"
                                               FontSize="13"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{Binding FeedTabText}" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Feed" />
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Border Grid.Column="1"
                                            BackgroundColor="{Binding RankingsTabBg}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13"
                                            Padding="0,8">
                                        <Label Text="🏆 Rankings"
                                               FontFamily="NunitoBold"
                                               FontSize="13"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{Binding RankingsTabText}" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Rankings" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="18,0"
                                    Padding="16"
                                    BackgroundColor="{StaticResource CardBg}"
                                    Stroke="{StaticResource Secondary20}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22">
                                <Border.Shadow>
                                    <Shadow Brush="#14000000" Offset="0,4" Radius="12" Opacity="0.14" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="13">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                        <Border WidthRequest="44"
                                                HeightRequest="44"
                                                BackgroundColor="{StaticResource Secondary}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 22">
                                            <Grid>
                                                <Label Text="{Binding Initials}"
                                                       TextColor="White"
                                                       FontFamily="NunitoBold"
                                                       FontSize="15"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                                <Image Source="{Binding ProfilePicture, Converter={StaticResource Base64ToImageSourceConverter}}"
                                                       Aspect="AspectFill" />
                                            </Grid>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding AuthorName}"
                                                       FontFamily="NunitoBold"
                                                       FontSize="15"
                                                       TextColor="{StaticResource BodyText}"
                                                       LineBreakMode="TailTruncation" />
                                                <Border BackgroundColor="#FEF3C7" Stroke="#F59E0B" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5,1" IsVisible="{Binding IsAuthorPremium}" VerticalOptions="Center">
                                                    <Label Text="🏅 Premium" FontSize="10" FontFamily="NunitoBold" TextColor="#B45309" />
                                                </Border>
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding TimeAgo}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray500}" />
                                                <Label Text="Edited"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray500}"
                                                       IsVisible="{Binding IsEdited}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Border Grid.Column="2"
                                                IsVisible="{Binding PetName, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                                BackgroundColor="{StaticResource Highlight30}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="9,5"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding PetName}"
                                                   FontFamily="NunitoSemiBold"
                                                   FontSize="11"
                                                   TextColor="{StaticResource SecondaryFg}"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding Content}"
                                           FontSize="15"
                                           LineHeight="1.18"
                                           TextColor="{StaticResource BodyText}" />

                                    <CollectionView ItemsSource="{Binding ImageList}"
                                                    IsVisible="{Binding HasImages}"
                                                    HeightRequest="238"
                                                    SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border WidthRequest="300"
                                                        HeightRequest="238"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 16"
                                                        BackgroundColor="{StaticResource Secondary10}">
                                                    <Image Source="{Binding .}"
                                                           Aspect="AspectFill" />
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1,0,0">
                                        <Label Text="{Binding LikesCount, StringFormat='{0} likes'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}" />
                                        <Label Grid.Column="2"
                                               Text="{Binding CommentsCount, StringFormat='{0} comments'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Text="{Binding IsLikedByMe, Converter={StaticResource BoolToLikeTextConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CommunityViewModel}}, Path=ToggleLikeCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Secondary10}"
                                                TextColor="{Binding IsLikedByMe, Converter={StaticResource BoolToLikeColorConverter}}"
                                                FontFamily="NunitoBold"
                                                FontSize="13"
                                                CornerRadius="14"
                                                HeightRequest="42" />
                                        <Button Grid.Column="1"
                                                Text="Comment"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CommunityViewModel}}, Path=GoToPostDetailsCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Secondary10}"
                                                TextColor="{StaticResource Primary}"
                                                FontFamily="NunitoBold"
                                                FontSize="13"
                                                CornerRadius="14"
                                                HeightRequest="42" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="110" Color="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <!-- Rankings Leaderboard View -->
            <RefreshView IsVisible="{Binding ShowRankingsTab}"
                         Command="{Binding RefreshCommand}"
                         IsRefreshing="{Binding IsRefreshing}"
                         RefreshColor="{StaticResource Primary}">
                <CollectionView ItemsSource="{Binding Rankings}"
                                SelectionMode="None"
                                Margin="0"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout Padding="18,16,18,14" Spacing="14">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Community Leaderboard"
                                       FontFamily="NunitoExtraBold"
                                       FontSize="26"
                                       TextColor="{StaticResource BodyText}" />
                                <Label Text="Top pet lovers ranked by posts, comments, and community likes."
                                       FontFamily="Nunito"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>

                            <!-- Feed / Rankings Segmented Switch -->
                            <Border BackgroundColor="{StaticResource Secondary10}"
                                    Stroke="{StaticResource Secondary20}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="4">
                                <Grid ColumnDefinitions="*,*">
                                    <Border BackgroundColor="{Binding FeedTabBg}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13"
                                            Padding="0,8">
                                        <Label Text="Community Feed"
                                               FontFamily="NunitoBold"
                                               FontSize="13"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{Binding FeedTabText}" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Feed" />
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Border Grid.Column="1"
                                            BackgroundColor="{Binding RankingsTabBg}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13"
                                            Padding="0,8">
                                        <Label Text="🏆 Rankings"
                                               FontFamily="NunitoBold"
                                               FontSize="13"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{Binding RankingsTabText}" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Rankings" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="18,0"
                                    Padding="14"
                                    BackgroundColor="{StaticResource CardBg}"
                                    Stroke="{StaticResource Secondary20}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18">
                                <Border.Shadow>
                                    <Shadow Brush="#10000000" Offset="0,2" Radius="8" Opacity="0.1" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="36,44,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Label Text="{Binding RankBadge}"
                                           FontSize="18"
                                           FontFamily="NunitoBold"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           TextColor="{StaticResource Primary}" />

                                    <Border Grid.Column="1"
                                            WidthRequest="42"
                                            HeightRequest="42"
                                            BackgroundColor="{StaticResource Primary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 21"
                                            VerticalOptions="Center">
                                        <Grid>
                                            <Label Text="{Binding Initial}"
                                                   TextColor="White"
                                                   FontFamily="NunitoBold"
                                                   FontSize="15"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding Avatar, Converter={StaticResource Base64ToImageSourceConverter}}"
                                                   Aspect="AspectFill" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding FullName}"
                                               FontFamily="NunitoBold"
                                               FontSize="14"
                                               TextColor="{StaticResource BodyText}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding DisplayStats}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="3"
                                            BackgroundColor="{StaticResource Primary10}"
                                            Stroke="{StaticResource Primary20}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="8,4"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Score, StringFormat='{0} pts'}"
                                               FontFamily="NunitoBold"
                                               FontSize="11"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="110" Color="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <VerticalStackLayout IsVisible="{Binding IsLoading}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="{StaticResource Primary}"
                                   WidthRequest="34"
                                   HeightRequest="34" />
                <Label Text="Loading community..."
                       FontSize="13"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <Border IsVisible="{Binding IsEmpty}"
                    Margin="28"
                    Padding="24"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource CardBg}"
                    Stroke="{StaticResource Secondary20}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="No posts yet"
                           FontFamily="NunitoBold"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Be the first to share a pet story or helpful tip."
                           FontSize="13"
                           TextColor="{StaticResource Gray500}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Create a post"
                            Command="{Binding GoToCreatePostCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontFamily="NunitoBold"
                            CornerRadius="16"
                            Margin="0,6,0,0"
                            Padding="18,10" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasError}"
                    Margin="28"
                    Padding="22"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource CardBg}"
                    Stroke="{StaticResource StatusOverdue}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Community is unavailable"
                           FontFamily="NunitoBold"
                           FontSize="18"
                           TextColor="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Try again"
                            Command="{Binding RetryCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontFamily="NunitoBold"
                            CornerRadius="16"
                            Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <controls:FloatingTabBar SelectedTab="community"
                                     VerticalOptions="End"
                                     ZIndex="10" />
        </Grid>
    </Grid>
</ContentPage>