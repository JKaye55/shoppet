<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ShoppetApp.Controls"
             xmlns:models="clr-namespace:ShoppetApp.Models"
             x:Class="ShoppetApp.Pages.ShopPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="*">

        <!-- Main Content -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <controls:HeaderView Grid.Row="0" />

            <!-- Header -->
            <Border Grid.Row="1" BackgroundColor="{StaticResource CardBg}" StrokeThickness="0" Padding="16,12,16,0">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <Label Grid.Column="0"
                               Text="Preloved Marketplace"
                               FontFamily="NunitoExtraBold"
                               FontSize="26"
                               TextColor="{StaticResource BodyText}"
                               VerticalOptions="Center" />

                        <Path Grid.Column="1"
                              Data="{StaticResource IconSearch}"
                              Fill="{StaticResource BodyText}"
                              WidthRequest="22"
                              HeightRequest="22"
                              Aspect="Uniform"
                              VerticalOptions="Center">
                            <Path.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchTapped"/>
                            </Path.GestureRecognizers>
                        </Path>

                        <Border Grid.Column="2"
                                WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{StaticResource Secondary10}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCartTapped"/>
                            </Border.GestureRecognizers>
                            <Path Data="{StaticResource IconCart}"
                                  Fill="{StaticResource Primary}"
                                  WidthRequest="20"
                                  HeightRequest="20"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Aspect="Uniform"/>
                        </Border>
                    </Grid>

                    <!-- Filter Tabs -->
                    <Label Text="Use one Pet Owner account to shop or sell. There is no separate seller account."
                           FontSize="12" TextColor="{StaticResource Secondary}" />
                    <HorizontalStackLayout Spacing="0">
                        <Button x:Name="BtnSell" Text="Sell & Manage" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" FontSize="15" Clicked="OnSellTabClicked" Padding="0,6,20,6"/>
                        <Button x:Name="BtnExplore" Text="Shop" BackgroundColor="{StaticResource Primary}" TextColor="White" FontFamily="NunitoBold" FontSize="15" CornerRadius="20" Clicked="OnExploreTabClicked" Padding="16,6"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Search bar (hidden by default) -->
            <Border x:Name="SearchPanel" Grid.Row="2" BackgroundColor="{StaticResource CardBg}" StrokeThickness="0" Padding="16,8" IsVisible="False">
                <Border BackgroundColor="{StaticResource AppBackground}" StrokeThickness="1" Stroke="{StaticResource Secondary30}" StrokeShape="RoundRectangle 12" Padding="12,8">
                    <Entry x:Name="SearchEntry" Placeholder="Search preloved pet items..." TextColor="{StaticResource BodyText}" PlaceholderColor="#888" BackgroundColor="Transparent" TextChanged="OnSearchTextChanged"/>
                </Border>
            </Border>

            <!-- Content Panel -->
            <Grid Grid.Row="3">

                <!-- EXPLORE TAB -->
                <Grid x:Name="ExplorePanel" RowDefinitions="Auto,*">
                    <!-- Category pills -->
                    <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="16,8">
                        <HorizontalStackLayout Spacing="8" x:Name="CategoryPills">
                            <Button Text="All" x:Name="BtnCatAll" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="20" HeightRequest="34" FontSize="13" FontFamily="NunitoBold" Clicked="OnCategoryAllClicked" Padding="14,0"/>
                            <Button Text="Food &amp; Treats" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource BodyText}" CornerRadius="20" HeightRequest="34" FontSize="13" Clicked="OnCategoryClicked" CommandParameter="Food &amp; Treats" Padding="14,0"/>
                            <Button Text="Accessories" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource BodyText}" CornerRadius="20" HeightRequest="34" FontSize="13" Clicked="OnCategoryClicked" CommandParameter="Accessories" Padding="14,0"/>
                            <Button Text="Medicine" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource BodyText}" CornerRadius="20" HeightRequest="34" FontSize="13" Clicked="OnCategoryClicked" CommandParameter="Medicine" Padding="14,0"/>
                            <Button Text="Cage &amp; Beds" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource BodyText}" CornerRadius="20" HeightRequest="34" FontSize="13" Clicked="OnCategoryClicked" CommandParameter="Cage &amp; Beds" Padding="14,0"/>
                            <Button Text="Toys" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource BodyText}" CornerRadius="20" HeightRequest="34" FontSize="13" Clicked="OnCategoryClicked" CommandParameter="Toys" Padding="14,0"/>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Explore Grid -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="8,0,8,100">
                            <Label Text="Available Items" FontFamily="NunitoBold" FontSize="16" TextColor="{StaticResource BodyText}" Margin="8,8,8,8"/>
                            <Label x:Name="ExploreEmptyLabel" Text="No available items yet." TextColor="#888" HorizontalOptions="Center" Margin="0,40" IsVisible="False"/>
                            <CollectionView x:Name="ExploreGrid"
                                            ItemsLayout="VerticalGrid, 2"
                                            SelectionMode="Single"
                                            SelectionChanged="OnListingTapped">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MarketplaceListing">
                                        <Grid Padding="6">
                                            <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                                <VerticalStackLayout>
                                                    <!-- Image -->
                                                    <Grid HeightRequest="160" BackgroundColor="#E8E8E8">
                                                        <Image Source="{Binding FirstImage}" Aspect="AspectFill" HeightRequest="160" IsVisible="{Binding HasImages}"/>
                                                        <Border BackgroundColor="#80000000" StrokeThickness="0" VerticalOptions="End" Padding="6,4">
                                                            <Label Text="{Binding PriceDisplay}" TextColor="White" FontFamily="NunitoBold" FontSize="14"/>
                                                        </Border>
                                                    </Grid>
                                                    <!-- Info -->
                                                    <VerticalStackLayout Padding="8,6" Spacing="2">
                                                        <Label Text="{Binding Title}" TextColor="{StaticResource BodyText}" FontFamily="NunitoBold" FontSize="13" LineBreakMode="TailTruncation" MaxLines="2"/>
                                                        <Label Text="{Binding SellerName, StringFormat='Listed by {0}'}" TextColor="#888" FontSize="11"/>
                                                        <Label Text="{Binding TimeAgo}" TextColor="#aaa" FontSize="10"/>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <!-- SELL TAB -->
                <Grid x:Name="SellPanel" IsVisible="False" RowDefinitions="Auto,*">
                    <!-- Post button -->
                    <Border Grid.Row="0" BackgroundColor="{StaticResource CardBg}" StrokeThickness="0" Padding="16,10">
                        <Button Text="Sell an Item" BackgroundColor="{StaticResource Primary}" TextColor="White" FontFamily="NunitoBold" FontSize="15" CornerRadius="12" HeightRequest="48" Clicked="OnPostItemClicked"/>
                    </Border>

                    <!-- My Listings -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="16,8,16,100" Spacing="12">
                            <Label Text="My Listings" FontFamily="NunitoBold" FontSize="16" TextColor="{StaticResource BodyText}"/>
                            <Label x:Name="SellEmptyLabel" Text="You have no listings yet. Tap 'Sell an Item' to sell a preloved pet item." TextColor="#888" HorizontalOptions="Center" IsVisible="False" HorizontalTextAlignment="Center" Margin="0,30"/>
                            <VerticalStackLayout x:Name="MyListingsContainer" Spacing="12" BindableLayout.ItemsSource="{Binding MyListings}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:MarketplaceListing">
                                        <Border BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="0,0,0,12">
                                            <VerticalStackLayout Spacing="0">
                                                <!-- Image -->
                                                <Grid HeightRequest="200" BackgroundColor="#E8E8E8">
                                                    <Image Source="{Binding FirstImage}" Aspect="AspectFill" HeightRequest="200" IsVisible="{Binding HasImages}"/>
                                                    </Grid>
                                                <!-- Content -->
                                                <VerticalStackLayout Padding="12,10" Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label Grid.Column="0" Text="{Binding Title}" TextColor="{StaticResource BodyText}" FontFamily="NunitoBold" FontSize="16"/>
                                                        <Label Grid.Column="1" Text="{Binding PriceDisplay}" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" FontSize="15"/>
                                                    </Grid>
                                                    <Label Text="{Binding Category}" TextColor="#888" FontSize="12"/>
                                                    <Label Text="{Binding Description}" TextColor="{StaticResource BodyText}" FontSize="13" LineBreakMode="TailTruncation" MaxLines="2"/>
                                                </VerticalStackLayout>
                                                <!-- Actions -->
                                                <Grid ColumnDefinitions="*,*" Padding="12,0">
                                                    <Button Grid.Column="0" Text="Edit" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource Primary}" BorderColor="{StaticResource Primary}" BorderWidth="1" CornerRadius="8" FontFamily="NunitoBold" Clicked="OnEditListingClicked" CommandParameter="{Binding .}"/>
                                                    <Button Grid.Column="1" Text="Delete" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource StatusOverdue}" BorderColor="{StaticResource StatusOverdue}" BorderWidth="1" CornerRadius="8" FontFamily="NunitoBold" Margin="8,0,0,0" Clicked="OnDeleteListingClicked" CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Floating Tab Bar -->
        <controls:FloatingTabBar SelectedTab="shop" VerticalOptions="End"/>

        <!-- Listing Detail Modal -->
        <Grid x:Name="DetailModal" IsVisible="False" BackgroundColor="#99000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissModal"/>
            </Grid.GestureRecognizers>
            <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    Margin="16,60" VerticalOptions="Center" HorizontalOptions="Fill">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnModalBodyTapped"/>
                </Border.GestureRecognizers>
                <ScrollView MaximumHeightRequest="600">
                    <VerticalStackLayout Spacing="0">
                        <!-- Images carousel placeholder -->
                        <Grid x:Name="DetailImageContainer" HeightRequest="240" BackgroundColor="#E8E8E8">
                            <Image x:Name="DetailImage" Aspect="AspectFill" HeightRequest="240"/>
                            </Grid>
                        <!-- Details -->
                        <VerticalStackLayout Padding="16" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label x:Name="DetailTitle" Grid.Column="0" TextColor="{StaticResource BodyText}" FontFamily="NunitoBold" FontSize="20"/>
                                <Label x:Name="DetailPrice" Grid.Column="1" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" FontSize="20"/>
                            </Grid>
                            <HorizontalStackLayout Spacing="8">
                                <Label x:Name="DetailCategory" TextColor="#888" FontSize="13"/>
                                <Label Text="|" TextColor="#ddd"/>
                                <Label x:Name="DetailCondition" TextColor="#888" FontSize="13"/>
                            </HorizontalStackLayout>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary30}" Margin="0,4"/>
                            <Label Text="Description" FontFamily="NunitoBold" FontSize="14" TextColor="{StaticResource BodyText}"/>
                            <Label x:Name="DetailDescription" TextColor="{StaticResource BodyText}" FontSize="14"/>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary30}" Margin="0,4"/>
                            <HorizontalStackLayout Spacing="10">
                                <Border WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                                    <Grid><Label x:Name="DetailSellerInitial" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="NunitoBold" FontSize="16"/><Image x:Name="DetailSellerImage" Aspect="AspectFill"/></Grid>
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="0"><Label Text="Listed by" TextColor="{StaticResource Secondary}" FontSize="10"/><Label x:Name="DetailSellerName" TextColor="{StaticResource BodyText}" FontFamily="NunitoBold" FontSize="14"/></VerticalStackLayout>
                                    <Label x:Name="DetailLocation" TextColor="#888" FontSize="12"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label x:Name="DetailTime" TextColor="#aaa" FontSize="11"/>

                            <VerticalStackLayout x:Name="SellerSocialPanel" Spacing="6" IsVisible="False">
                                <Label Text="Optional contact links" FontFamily="NunitoSemiBold" FontSize="12" TextColor="{StaticResource Secondary}"/>
                                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                    <Button x:Name="BtnFacebook"
                                            Text="Facebook"
                                            IsVisible="False"
                                            BackgroundColor="{StaticResource Secondary10}"
                                            TextColor="{StaticResource BodyText}"
                                            CornerRadius="14"
                                            Margin="0,0,6,6"
                                            Padding="12,6"
                                            Clicked="OnFacebookClicked"/>
                                    <Button x:Name="BtnInstagram"
                                            Text="Instagram"
                                            IsVisible="False"
                                            BackgroundColor="{StaticResource Secondary10}"
                                            TextColor="{StaticResource BodyText}"
                                            CornerRadius="14"
                                            Margin="0,0,6,6"
                                            Padding="12,6"
                                            Clicked="OnInstagramClicked"/>
                                    <Button x:Name="BtnOtherSocial"
                                            Text="Other Link"
                                            IsVisible="False"
                                            BackgroundColor="{StaticResource Secondary10}"
                                            TextColor="{StaticResource BodyText}"
                                            CornerRadius="14"
                                            Margin="0,0,6,6"
                                            Padding="12,6"
                                            Clicked="OnOtherSocialClicked"/>
                                </FlexLayout>
                                <Label Text="These optional links are visible only because this Pet Owner enabled Marketplace sharing."
                                       FontSize="10" TextColor="{StaticResource Secondary}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Border x:Name="BtnAddToCart"
                                            Grid.Column="0"
                                            BackgroundColor="{StaticResource Primary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="12,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAddToCartTapped"/>
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                            <Path Data="{StaticResource IconCart}" Fill="White" WidthRequest="18" HeightRequest="18" Aspect="Uniform" />
                                            <Label Text="Add to Cart" TextColor="White" FontFamily="NunitoBold" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border x:Name="BtnMessageSeller"
                                            Grid.Column="1"
                                            BackgroundColor="{StaticResource Secondary10}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="12,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMessageSellerTapped"/>
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                            <Path Data="{StaticResource IconMessage}" Fill="{StaticResource Primary}" WidthRequest="18" HeightRequest="18" Aspect="Uniform" />
                                            <Label Text="Message Owner" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <Button Text="Close"
                                        BackgroundColor="{StaticResource CardBg}"
                                        TextColor="{StaticResource BodyText}"
                                        BorderColor="{StaticResource Secondary30}"
                                        BorderWidth="1"
                                        CornerRadius="10"
                                        FontFamily="NunitoBold"
                                        Clicked="OnDismissModal"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Create/Edit Listing Modal -->
        <Grid x:Name="PostModal" IsVisible="False" BackgroundColor="#99000000">
            <Border BackgroundColor="{StaticResource CardBg}" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    Margin="16,80" VerticalOptions="Center" HorizontalOptions="Fill">
                <ScrollView MaximumHeightRequest="580">
                    <VerticalStackLayout Padding="20" Spacing="14">
                        <Label x:Name="PostModalTitle" Text="Sell a Pet Item" FontFamily="NunitoBold" FontSize="20" TextColor="{StaticResource BodyText}"/>

                        <Label Text="Item Title *" TextColor="{StaticResource BodyText}" FontSize="13" FontFamily="NunitoSemiBold"/>
                        <Border BackgroundColor="{StaticResource AppBackground}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,8">
                            <Entry x:Name="EntryTitle" Placeholder="e.g. Dog carrier, gently used" MaxLength="80" TextColor="{StaticResource BodyText}" BackgroundColor="Transparent"/>
                        </Border>
                        <Label Text="2–80 characters" TextColor="{StaticResource Secondary}" FontSize="11"/>

                        <Label Text="Price (PHP) *" TextColor="{StaticResource BodyText}" FontSize="13" FontFamily="NunitoSemiBold"/>
                        <Border BackgroundColor="{StaticResource AppBackground}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,8">
                            <Entry x:Name="EntryPrice" Placeholder="0.00" Keyboard="Numeric" MaxLength="9" TextColor="{StaticResource BodyText}" BackgroundColor="Transparent"/>
                        </Border>

                        <Label Text="Category *" TextColor="{StaticResource BodyText}" FontSize="13" FontFamily="NunitoSemiBold"/>
                        <Border BackgroundColor="{StaticResource AppBackground}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="4,0">
                            <Picker x:Name="PickerCategory" TextColor="{StaticResource BodyText}" BackgroundColor="Transparent">
                                <Picker.Items>
                                    <x:String>General</x:String>
                                    <x:String>Food &amp; Treats</x:String>
                                    <x:String>Accessories</x:String>
                                    <x:String>Medicine</x:String>
                                    <x:String>Cage &amp; Beds</x:String>
                                    <x:String>Toys</x:String>
                                    <x:String>Grooming</x:String>
                                    <x:String>Other</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <Label Text="Condition *" TextColor="{StaticResource BodyText}" FontSize="13" FontFamily="NunitoSemiBold"/>
                        <Border BackgroundColor="{StaticResource AppBackground}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="4,0">
                            <Picker x:Name="PickerCondition" TextColor="{StaticResource BodyText}" BackgroundColor="Transparent">
                                <Picker.Items>
                                    <x:String>Brand New</x:String>
                                    <x:String>Like New</x:String>
                                    <x:String>Good</x:String>
                                    <x:String>Used</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <Label Text="General Meetup Area *" TextColor="{StaticResource BodyText}" FontSize="13" FontFamily="NunitoSemiBold"/>
                        <Border BackgroundColor="{StaticResource AppBackground}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="4,0">
                            <Picker x:Name="PickerLocation"
                                    Title="Select meetup area"
                                    TitleColor="{StaticResource Secondary}"
                                    TextColor="{StaticResource BodyText}"
                                    BackgroundColor="Transparent">
                                <Picker.Items>
                                    <x:String>Lipa City</x:String>
                                    <x:String>Tanauan City</x:String>
                                    <x:String>Malvar</x:String>
                                    <x:String>Sto. Tomas</x:String>
                                    <x:String>Other nearby area</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                        <Label Text="Privacy: choose only a city or general meetup area. Never enter your home address."
                               TextColor="{StaticResource Secondary}" FontSize="11"/>

                        <Label Text="Description *" TextColor="{StaticResource BodyText}" FontSize="13" FontFamily="NunitoSemiBold"/>
                        <Border BackgroundColor="{StaticResource AppBackground}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,8">
                            <Editor x:Name="EditorDescription" Placeholder="Describe condition, size, inclusions, defects, expiry details if applicable, and what the buyer should know." MaxLength="500" TextColor="{StaticResource BodyText}" BackgroundColor="Transparent" HeightRequest="90" AutoSize="TextChanges"/>
                        </Border>

                        <Label Text="Photos *" TextColor="{StaticResource BodyText}" FontSize="13" FontFamily="NunitoSemiBold"/>
                        <Border BackgroundColor="{StaticResource AppBackground}" Stroke="{StaticResource Primary}" StrokeThickness="1" StrokeDashArray="6,4" StrokeShape="RoundRectangle 12" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickPhotoTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Path Data="{StaticResource IconCamera}" Fill="{StaticResource Primary}" WidthRequest="22" HeightRequest="22" Aspect="Uniform"/>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Add item photos" FontFamily="NunitoBold" TextColor="{StaticResource BodyText}" />
                                    <Label Text="1–5 clear photos. Avoid showing personal documents or private addresses."
                                           FontSize="11" TextColor="{StaticResource Secondary}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                        <CollectionView x:Name="PickedPhotosView" ItemsLayout="HorizontalList" HeightRequest="90" IsVisible="False">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="80" HeightRequest="80" Margin="4,4">
                                        <Image Source="{Binding .}" Aspect="AspectFill" HeightRequest="80" WidthRequest="80"/>
                                        <Border BackgroundColor="#CC000000" StrokeThickness="0" WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0">
                                            <Grid>
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRemovePickedPhoto" CommandParameter="{Binding .}"/>
                                                </Grid.GestureRecognizers>
                                                <Path Data="{StaticResource IconClose}" Fill="White" WidthRequest="12" HeightRequest="12" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Border BackgroundColor="{StaticResource Secondary10}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                            <HorizontalStackLayout Spacing="8">
                                <Path Data="{StaticResource IconShield}" Fill="{StaticResource Primary}" WidthRequest="18" HeightRequest="18" Aspect="Uniform"/>
                                <Label Text="Your account name is shown as the listing owner. Your mobile number stays private. Optional social links appear only when you enable Marketplace sharing in Profile."
                                       FontSize="11" TextColor="{StaticResource BodyText}" LineBreakMode="WordWrap"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Cancel" BackgroundColor="{StaticResource CardBg}" TextColor="{StaticResource BodyText}" BorderColor="{StaticResource Secondary30}" BorderWidth="1" CornerRadius="10" FontFamily="NunitoBold" Clicked="OnCancelPostClicked"/>
                            <Button Grid.Column="1" Text="Publish Listing" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="10" FontFamily="NunitoBold" Clicked="OnSaveListingClicked"/>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>
</ContentPage>







