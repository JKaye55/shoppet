<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShoppetApp.Pages.PremiumPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,36" Spacing="18">

            <!-- Top Bar -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Secondary30}" Padding="10,6" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#x25C0; Back" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" FontSize="14" VerticalOptions="Center" />
                </Border>
                <Label Text="Premium Plan" TextColor="{StaticResource BodyText}" FontFamily="NunitoExtraBold" FontSize="18" VerticalOptions="Center" Margin="6,0,0,0"/>
            </HorizontalStackLayout>

            <!-- Hero Banner -->
            <Border BackgroundColor="#173D3D" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="22">
                <VerticalStackLayout Spacing="8">
                    <Border HorizontalOptions="Start" BackgroundColor="#2F9098" StrokeShape="RoundRectangle 6" Padding="8,4" StrokeThickness="0">
                        <Label Text="⭐ ALL-ACCESS PLAN" TextColor="White" FontFamily="NunitoBold" FontSize="10" />
                    </Border>
                    <Label Text="ShoppetCare Premium" TextColor="White" FontFamily="NunitoExtraBold" FontSize="24" />
                    <Label Text="One upgrade. Unlimited peace of mind for you and your pets." TextColor="#B2DFDB" FontSize="13" />

                    <!-- Price Tag -->
                    <HorizontalStackLayout Spacing="4" Margin="0,10,0,0" VerticalOptions="Center">
                        <Label Text="₱" TextColor="#F3D27A" FontFamily="NunitoBold" FontSize="18" VerticalOptions="Start" Margin="0,4,0,0"/>
                        <Label Text="150" TextColor="White" FontFamily="NunitoExtraBold" FontSize="34" VerticalOptions="Center" />
                        <Label Text="/ 2 months" TextColor="#B2DFDB" FontSize="14" FontFamily="NunitoBold" VerticalOptions="Center" Margin="4,0,0,0"/>
                    </HorizontalStackLayout>
                    <Label Text="Academic simulation · No real credit card or bank fees" TextColor="#80CBC4" FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <!-- Status Card -->
            <Border Padding="16,14" BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary20}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource Secondary30}" StrokeThickness="0">
                        <Label x:Name="StatusIconLabel" Text="🛡️" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="ACCOUNT STATUS" TextColor="{StaticResource NavMuted}" FontSize="10" FontFamily="NunitoBold" />
                        <Label x:Name="StatusLabel" Text="Checking status..." FontFamily="NunitoBold" FontSize="15" TextColor="{StaticResource Primary}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Receipt Card (Visible on activation) -->
            <Border x:Name="ReceiptCard" IsVisible="False" Padding="20" BackgroundColor="#F0FDFC" Stroke="#99F6E4" StrokeThickness="1.5" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="✅" FontSize="18" VerticalOptions="Center" />
                        <Label Text="Simulated Payment Receipt" TextColor="#0F766E" FontFamily="NunitoExtraBold" FontSize="16" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" Color="#CCFBF1" />
                    <Label x:Name="ReceiptRefLabel" Text="Ref: PREM-XXXXXXXX" TextColor="#134E4A" FontFamily="NunitoBold" FontSize="13" />
                    <Label x:Name="ReceiptDurationLabel" Text="Duration: 60 Days (2 Months)" TextColor="#134E4A" FontSize="12" />
                    <Label x:Name="ReceiptAmountLabel" Text="Amount Paid: ₱150.00 (Demo)" TextColor="#0F766E" FontFamily="NunitoExtraBold" FontSize="14" />
                    <Label Text="Your permissions have updated immediately across Web and Mobile." TextColor="#115E59" FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <!-- Features Unlocked -->
            <Border Padding="20" BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary20}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="What's Included in Premium" FontFamily="NunitoBold" FontSize="16" TextColor="{StaticResource BodyText}"/>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🐾" FontSize="16" VerticalOptions="Start" />
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Unlimited Pet Profiles" FontFamily="NunitoBold" FontSize="13" TextColor="{StaticResource BodyText}" />
                            <Label Text="Create profiles for all your pets without the 1-pet limit." TextColor="{StaticResource NavMuted}" FontSize="11" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="💉" FontSize="16" VerticalOptions="Start" />
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Unlimited Health Records" FontFamily="NunitoBold" FontSize="13" TextColor="{StaticResource BodyText}" />
                            <Label Text="Log endless vaccinations, medications, weight, and history." TextColor="{StaticResource NavMuted}" FontSize="11" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🛍️" FontSize="16" VerticalOptions="Start" />
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Unlimited Marketplace Listings" FontFamily="NunitoBold" FontSize="13" TextColor="{StaticResource BodyText}" />
                            <Label Text="List and manage more than 3 pre-loved items for buyers." TextColor="{StaticResource NavMuted}" FontSize="11" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🪪" FontSize="16" VerticalOptions="Start" />
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Digital Pet ID Badges" FontFamily="NunitoBold" FontSize="13" TextColor="{StaticResource BodyText}" />
                            <Label Text="Unlock exclusive themes and high-res shareable QR cards." TextColor="{StaticResource NavMuted}" FontSize="11" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <VerticalStackLayout Spacing="10">
                <Button x:Name="ActivateButton"
                        Text="Upgrade to Premium · ₱150 (Demo)"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="50"
                        FontFamily="NunitoBold"
                        FontSize="15"
                        Clicked="OnActivateClicked"/>

                <Button x:Name="OpenWebButton"
                        Text="Open Web Portal (/premium)"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1.5"
                        CornerRadius="16"
                        HeightRequest="46"
                        FontFamily="NunitoBold"
                        FontSize="14"
                        Clicked="OnOpenWebPremiumClicked"/>

                <Label Text="Your ₱150 / 2-month plan applies across both Android mobile and Web Blazor."
                       FontSize="11"
                       TextColor="{StaticResource NavMuted}"
                       HorizontalTextAlignment="Center"
                       Margin="0,4,0,0"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>