<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShoppetApp.Pages.PremiumPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="18,22,18,32" Spacing="16">
            <Button Text="Back" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" Clicked="OnBackClicked"/>
            <Label Text="ShoppetCare Premium" FontFamily="NunitoExtraBold" FontSize="27" TextColor="{StaticResource BodyText}"/>
            <Label Text="One-time demo upgrade tied to your shared ShoppetCare account." FontSize="13" TextColor="{StaticResource NavMuted}"/>
            <Border Padding="20" BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary20}" StrokeThickness="1" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="StatusLabel" Text="Checking status..." FontFamily="NunitoBold" FontSize="18" TextColor="{StaticResource Primary}"/>
                    <Label Text="Premium (2 Months) unlocks unlimited pets and health records, plus advanced Pet ID customization and marketplace perks." FontSize="13" TextColor="{StaticResource BodyText}"/>
                    <Label Text="₱150 for 2 Months • mock payment only" FontFamily="NunitoExtraBold" FontSize="20" TextColor="{StaticResource BodyText}"/>
                    <Button x:Name="ActivateButton" Text="Activate Premium (Simulation)" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="18" HeightRequest="50" FontFamily="NunitoBold" Clicked="OnActivateClicked"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>