<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             xmlns:controls="clr-namespace:ShoppetApp.Controls"
             x:Class="ShoppetApp.Pages.PostDetailsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource AppBackground}" StrokeThickness="0" Padding="15,10">
            <HorizontalStackLayout Spacing="10">
                <Label Text="&#x25C0; Back" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" FontSize="16" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </Border>

        <RefreshView Grid.Row="1" Command="{Binding LoadCommentsCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="15" Spacing="15">

                    <!-- Original Post Card -->
                    <Border BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="15">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="10">
                                <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                    <Label Text="{Binding Post.Initials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" FontFamily="NunitoBold" />
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding Post.AuthorName}" TextColor="{StaticResource BodyText}" FontFamily="NunitoBold" FontSize="16" />
                                        <Border BackgroundColor="#FEF3C7" Stroke="#F59E0B" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="5,1" IsVisible="{Binding Post.IsAuthorPremium}" VerticalOptions="Center">
                                            <Label Text="🏅 Premium" FontSize="10" FontFamily="NunitoBold" TextColor="#B45309" />
                                        </Border>
                                        <Label Text="{Binding Post.PetName, StringFormat=' is with {0}'}" TextColor="#666666" FontSize="14" IsVisible="{Binding Post.PetName, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Post.TimeAgo}" TextColor="#888888" FontSize="12" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Post.Content}" TextColor="{StaticResource BodyText}" FontSize="15" />
                            <CollectionView ItemsSource="{Binding Post.ImageList}"
                                            IsVisible="{Binding Post.HasImages}"
                                            HeightRequest="250"
                                            Margin="0,10"
                                            HorizontalScrollBarVisibility="Never">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="Transparent" Margin="0,0,10,0">
                                            <Image Source="{Binding .}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="250"
                                                   WidthRequest="300" />
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="{Binding Post.LikesCount, StringFormat='{0} Likes'}" TextColor="#666666" FontSize="13" />
                                <Label Text="{Binding Post.CommentsCount, StringFormat='{0} Comments'}" TextColor="#666666" FontSize="13" />
                            </HorizontalStackLayout>
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Text="{Binding Post.IsLikedByMe, Converter={StaticResource BoolToLikeTextConverter}}"
                                        Command="{Binding ToggleLikeCommand}"
                                        TextColor="{Binding Post.IsLikedByMe, Converter={StaticResource BoolToLikeColorConverter}}"
                                        BackgroundColor="Transparent" FontFamily="NunitoBold" />
                                <Button Grid.Column="1" Text="&#x1F5E8; Comment" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" FontFamily="NunitoBold" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary30}" Margin="0,5" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Comments List -->
                    <CollectionView x:Name="CommentsView" ItemsSource="{Binding Comments}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}">
                                    <!-- Avatar -->
                                    <Border Grid.Column="0" WidthRequest="{Binding AvatarSize}" HeightRequest="{Binding AvatarSize}" BackgroundColor="{StaticResource Secondary}" StrokeShape="Ellipse" StrokeThickness="0" VerticalOptions="Start" Margin="0,4,0,0">
                                        <Label Text="{Binding Initials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" FontFamily="NunitoBold" />
                                    </Border>
                                    
                                    <!-- Thread Content -->
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Fill" Spacing="2">
                                        <!-- Author Name ? ParentName -->
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding AuthorName}" TextColor="#AAAAAA" FontFamily="NunitoBold" FontSize="13" VerticalOptions="Center" />
                                            <Border BackgroundColor="#FEF3C7" Stroke="#F59E0B" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="4,1" IsVisible="{Binding IsAuthorPremium}" VerticalOptions="Center">
                                                <Label Text="🏅" FontSize="9" TextColor="#B45309" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="&#x25B6;" TextColor="#666666" FontSize="10" VerticalOptions="Center" IsVisible="{Binding HasParentQuote}" />
                                            <Label Text="{Binding ParentAuthorName}" TextColor="#AAAAAA" FontSize="13" FontFamily="NunitoBold" VerticalOptions="Center" IsVisible="{Binding HasParentQuote}" />
                                        </HorizontalStackLayout>
                                        
                                        <!-- Plain Text Comment (No Bubble) -->
                                        <Label Text="{Binding Content}" TextColor="{StaticResource BodyText}" FontSize="15" Margin="0,2,10,4" />
                                        
                                        <!-- Actions -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,10,12">
                                            <!-- Left side: Time, Reply -->
                                            <HorizontalStackLayout Grid.Column="0" Spacing="16" VerticalOptions="Center">
                                                <Label Text="{Binding TimeAgo}" TextColor="#888888" FontSize="12" VerticalOptions="Center" />
                                                <Label Text="Reply" TextColor="#888888" FontSize="12" FontFamily="NunitoBold" VerticalOptions="Center">
                                                      <Label.GestureRecognizers>
                                                          <TapGestureRecognizer Tapped="OnReplyTapped" />
                                                      </Label.GestureRecognizers>
                                                  </Label>
                                                  <Label Text="Delete" TextColor="{StaticResource StatusOverdue}" FontSize="12" FontFamily="NunitoBold" VerticalOptions="Center" IsVisible="{Binding CanDelete}">
                                                      <Label.GestureRecognizers>
                                                          <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PostDetailsViewModel}}, Path=DeleteCommentCommand}" CommandParameter="{Binding .}" />
                                                      </Label.GestureRecognizers>
                                                  </Label>
                                            </HorizontalStackLayout>
                                            
                                            <!-- Right side: Like Heart and Count -->
                                            <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                                                <Label Text="{Binding IsLikedByMe, Converter={StaticResource BoolToHeartIconConverter}}"
                                                       TextColor="{Binding IsLikedByMe, Converter={StaticResource BoolToLikeColorConverter}}"
                                                       FontSize="16" FontFamily="NunitoBold" VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnCommentLikeTapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <Label Text="{Binding LikeCount}" TextColor="#888888" FontSize="12" VerticalOptions="Center"
                                                       IsVisible="{Binding LikeCount, Converter={StaticResource CountToBoolConverter}}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        
                                        <!-- Pagination (View N replies / Hide) -->
                                        <HorizontalStackLayout Spacing="10" Margin="46,0,0,12" IsVisible="{Binding IsPaginatorVisible}" VerticalOptions="Center">
                                            <BoxView HeightRequest="1" WidthRequest="30" Color="#444" VerticalOptions="Center" />
                                            <Label Text="{Binding PaginatorText}" TextColor="#888888" FontSize="13" VerticalOptions="Center" FontFamily="NunitoBold" IsVisible="{Binding PaginatorText, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PostDetailsViewModel}}, Path=LoadMoreRepliesCommand}" CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Text="Hide &#x2303;" TextColor="#888888" FontSize="13" VerticalOptions="Center" FontFamily="NunitoBold" IsVisible="{Binding IsHideVisible}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PostDetailsViewModel}}, Path=HideRepliesCommand}" CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Input -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource CardBg}" Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="10">
            <VerticalStackLayout Spacing="6">
                <!-- Reply Banner -->
                <Border BackgroundColor="{StaticResource Primary10}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,6"
                        IsVisible="{Binding IsReplying}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" TextColor="{StaticResource Primary}" FontSize="13">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Replying to " />
                                    <Span Text="{Binding ReplyingToName}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Grid.Column="1" Text="&#x2715;" TextColor="{StaticResource Primary}" FontSize="14" FontFamily="NunitoBold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelReplyCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="{StaticResource Secondary30}" BackgroundColor="{StaticResource AppBackground}" Padding="15,0">
                        <Editor x:Name="CommentEditor"
                                Placeholder="Write a comment..."
                                Text="{Binding NewCommentText}"
                                TextColor="{StaticResource BodyText}"
                                PlaceholderColor="#888888"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges" />
                    </Border>
                    <Button Grid.Column="1" Text="Send" Command="{Binding SendCommentCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontFamily="NunitoBold" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>


</ContentPage>

























