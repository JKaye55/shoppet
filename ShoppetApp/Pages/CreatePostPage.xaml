<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             xmlns:controls="clr-namespace:ShoppetApp.Controls"
             x:Class="ShoppetApp.Pages.CreatePostPage"
             Title="New post"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="{StaticResource AppBackground}">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,20,15,15">
            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconClose}"
                      Fill="{StaticResource BodyText}"
                      WidthRequest="20"
                      HeightRequest="20"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Aspect="Uniform" />
            </Border>
            <Label Grid.Column="1" Text="New post" FontSize="18" FontFamily="NunitoBold" TextColor="{StaticResource BodyText}" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" WidthRequest="20" />
        </Grid>

        <!-- Body -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15" Padding="15,0,15,20">
                
                <HorizontalStackLayout Spacing="10">
                    <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 20" StrokeThickness="0" VerticalOptions="Start">
                        <Label Text="{Binding UserInitials}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14" FontFamily="NunitoBold" />
                    </Border>
                    
                    <VerticalStackLayout Spacing="5" VerticalOptions="Start">
                        <Label Text="{Binding UserFullName}" TextColor="{StaticResource BodyText}" FontFamily="NunitoBold" FontSize="16" />
                        
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <BindableLayout.ItemsSource>
                                <Binding Path="SelectedPets" />
                            </BindableLayout.ItemsSource>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,5" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Secondary30}" BackgroundColor="{StaticResource Secondary30}" >
                                        <Label Text="{Binding Name}" TextColor="{StaticResource BodyText}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            
                            <!-- Dotted Add Pet Button -->
                            <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Secondary}" StrokeDashArray="5,5" StrokeThickness="1" BackgroundColor="Transparent" Padding="10,5" >
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenPetModalCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Add Pet" TextColor="#888888" FontSize="12" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Editor Placeholder="What's on your mind?" 
                        PlaceholderColor="#888888" 
                        TextColor="{StaticResource BodyText}" 
                        Text="{Binding Content}" 
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges" 
                        MinimumHeightRequest="150" />
                        
                <Border BackgroundColor="{StaticResource Secondary10}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        Padding="12">
                    <HorizontalStackLayout Spacing="8">
                        <Path Data="{StaticResource IconShield}"
                              Fill="{StaticResource Primary}"
                              WidthRequest="18"
                              HeightRequest="18"
                              Aspect="Uniform" />
                        <Label Text="Community posts are visible to other ShoppetCare users. Avoid sharing phone numbers, exact home addresses, IDs, or private medical documents."
                               FontSize="11"
                               TextColor="{StaticResource BodyText}"
                               LineBreakMode="WordWrap" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Prominent photo attachment area: keeps the original Shoppet styling, but makes photo sharing obvious. -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        Stroke="{StaticResource Secondary}"
                        StrokeThickness="1"
                        StrokeDashArray="6,4"
                        StrokeShape="RoundRectangle 16"
                        Padding="16"
                        Margin="0,4,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AttachPhotoCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48"
                                BackgroundColor="{StaticResource Secondary30}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">
                            <Path Data="{StaticResource IconCamera}"
                                  Fill="{StaticResource Primary}"
                                  WidthRequest="24"
                                  HeightRequest="24"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Aspect="Uniform" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Add photos"
                                   FontFamily="NunitoBold"
                                   FontSize="15"
                                   TextColor="{StaticResource BodyText}" />
                            <Label Text="Tap to choose up to 5 photos from your device"
                                   FontSize="12"
                                   TextColor="#777777" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="Selected photos"
                       FontFamily="NunitoBold"
                       FontSize="13"
                       TextColor="{StaticResource BodyText}"
                       Margin="0,2,0,-4" />

                <CollectionView ItemsSource="{Binding AttachedMedia}" HeightRequest="120" Margin="0,0,0,0"
                                EmptyView="No photos selected yet.">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid WidthRequest="100" HeightRequest="100" Margin="0,5">
                                <RoundRectangle CornerRadius="10" Fill="#222222" />
                                
                                <!-- Image Preview -->
                                <Image Source="{Binding FilePath}" Aspect="AspectFill" IsVisible="{Binding IsImage}">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="10" Rect="0,0,100,100" />
                                    </Image.Clip>
                                </Image>
                                
                                <!-- Video Placeholder -->
                                <VerticalStackLayout IsVisible="{Binding IsVideo}" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Path Data="{StaticResource IconPlay}" Fill="White" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" Aspect="Uniform" />
                                    <Label Text="Video" TextColor="White" FontSize="12" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                
                                <!-- Remove Button -->
                                <Border BackgroundColor="#DD000000" WidthRequest="24" HeightRequest="24" 
                                        StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                        HorizontalOptions="End" VerticalOptions="Start" Margin="5">
                                    <Grid>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreatePostViewModel}}, Path=RemoveMediaCommand}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Path Data="{StaticResource IconClose}"
                                              Fill="White"
                                              WidthRequest="12"
                                              HeightRequest="12"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Aspect="Uniform" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="15,10,15,20" BackgroundColor="{StaticResource CardBg}">
            <Button Grid.Column="0"
                    Text="Add Photos"
                    BackgroundColor="{StaticResource Secondary30}"
                    TextColor="{StaticResource BodyText}"
                    FontFamily="NunitoBold"
                    CornerRadius="10"
                    HeightRequest="40"
                    HorizontalOptions="Fill"
                    Command="{Binding AttachPhotoCommand}" />
            
            <Button Grid.Column="1" Text="Post" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="White" 
                    FontFamily="NunitoBold" 
                    CornerRadius="10" 
                    Padding="20,5"
                    HeightRequest="40"
                    Command="{Binding PostCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
        </Grid>

        <!-- Modal Overlay -->
        <Grid Grid.RowSpan="3" BackgroundColor="#80000000" IsVisible="{Binding IsPetModalVisible}" ZIndex="10">
            <Border BackgroundColor="{StaticResource CardBg}" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="300" StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Select Pets" FontFamily="NunitoBold" FontSize="18" TextColor="{StaticResource BodyText}" HorizontalOptions="Center" />
                    
                    <CollectionView ItemsSource="{Binding MyPets}" SelectedItems="{Binding SelectedPets}" SelectionMode="Multiple" HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Secondary30}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label Text="{Binding Name}" TextColor="{StaticResource BodyText}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Done" Command="{Binding ClosePetModalCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="10" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>



