<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShoppetApp.ViewModels"
             x:Class="ShoppetApp.Pages.EditProfilePage"
             x:DataType="vm:EditProfileViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="44,*,Auto" Padding="15,14,15,10">
            <Border WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Path Data="{StaticResource IconClose}"
                      Fill="{StaticResource BodyText}"
                      WidthRequest="20"
                      HeightRequest="20"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Aspect="Uniform" />
            </Border>

            <Label Grid.Column="1"
                   Text="Edit Profile"
                   FontFamily="NunitoBold"
                   FontSize="18"
                   TextColor="{StaticResource BodyText}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Button Grid.Column="2"
                    Text="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontFamily="NunitoBold" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="18">

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border WidthRequest="108"
                            HeightRequest="108"
                            StrokeShape="RoundRectangle 54"
                            StrokeThickness="1"
                            Stroke="{StaticResource Secondary30}"
                            BackgroundColor="{StaticResource Primary10}">
                        <Grid>
                            <Path Data="{StaticResource IconUser}"
                                  Fill="{StaticResource Secondary}"
                                  WidthRequest="38"
                                  HeightRequest="38"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Aspect="Uniform" />
                            <Image Source="{Binding ProfileImageSource}" Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="54" Rect="0,0,108,108" />
                                </Image.Clip>
                            </Image>
                            <Border WidthRequest="32"
                                    HeightRequest="32"
                                    BackgroundColor="{StaticResource Primary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    HorizontalOptions="End"
                                    VerticalOptions="End">
                                <Path Data="{StaticResource IconCamera}"
                                      Fill="White"
                                      WidthRequest="17"
                                      HeightRequest="17"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Aspect="Uniform" />
                            </Border>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickPhotoCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Label Text="Tap to change profile photo"
                           TextColor="{StaticResource Secondary}"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Full Name *"
                           FontFamily="NunitoSemiBold"
                           FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Entry Text="{Binding FullName}"
                               MaxLength="80"
                               Placeholder="Your full name"
                               HeightRequest="52" />
                    </Border>
                    <Label Text="This name appears on your community posts and marketplace listings."
                           FontSize="11"
                           TextColor="{StaticResource Secondary}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Mobile Number"
                           FontFamily="NunitoSemiBold"
                           FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Entry Text="{Binding MobileNumber}"
                               Keyboard="Telephone"
                               MaxLength="11"
                               Placeholder="09XXXXXXXXX"
                               HeightRequest="52" />
                    </Border>
                    <Label Text="Kept private by default."
                           FontSize="11"
                           TextColor="{StaticResource Secondary}" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />

                <VerticalStackLayout Spacing="10">
                    <Label Text="Marketplace Contact Links"
                           FontFamily="NunitoBold"
                           FontSize="16"
                           TextColor="{StaticResource BodyText}" />
                    <Label Text="Your Pet Owner account can both shop and sell. These links are optional and are never required to create a listing."
                           FontSize="12"
                           TextColor="{StaticResource Secondary}" />

                    <Label Text="Facebook / Messenger"
                           FontFamily="NunitoSemiBold"
                           FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Entry Text="{Binding FacebookUrl}"
                               Keyboard="Url"
                               MaxLength="500"
                               Placeholder="https://facebook.com/..."
                               HeightRequest="52" />
                    </Border>

                    <Label Text="Instagram"
                           FontFamily="NunitoSemiBold"
                           FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Entry Text="{Binding InstagramUrl}"
                               Keyboard="Url"
                               MaxLength="500"
                               Placeholder="https://instagram.com/..."
                               HeightRequest="52" />
                    </Border>

                    <Label Text="Other Social Link"
                           FontFamily="NunitoSemiBold"
                           FontSize="13" />
                    <Border Stroke="{StaticResource Secondary30}" StrokeThickness="1" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Entry Text="{Binding OtherSocialUrl}"
                               Keyboard="Url"
                               MaxLength="500"
                               Placeholder="https://..."
                               HeightRequest="52" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,6">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Show my contact links in Marketplace"
                                   FontFamily="NunitoSemiBold"
                                   FontSize="13" />
                            <Label Text="Off by default. Other Pet Owners can still contact you through ShoppetCare Messages."
                                   FontSize="11"
                                   TextColor="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding ShowSocialLinksOnMarketplace}"
                                OnColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{StaticResource Secondary20}" />

                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Path Data="{StaticResource IconShield}"
                              Fill="{StaticResource Primary}"
                              WidthRequest="20"
                              HeightRequest="20"
                              Aspect="Uniform" />
                        <Label Text="Public Pet ID Privacy"
                               FontFamily="NunitoBold"
                               FontSize="16"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Show my mobile number on public Pet ID"
                                   FontFamily="NunitoSemiBold"
                                   FontSize="13" />
                            <Label Text="Only enable this if you want anyone scanning the public Pet ID to see your phone number."
                                   FontSize="11"
                                   TextColor="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding ShowMobileOnPublicPetId}"
                                OnColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                Text="Save Changes"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontFamily="NunitoBold"
                CornerRadius="24"
                HeightRequest="52"
                Margin="20,10,20,20" />

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#66000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
