<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ShoppetApp.Pages.ImagePreviewPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid>
        <!-- The Image -->
        <Image x:Name="PreviewImage" Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- The Video -->
        <toolkit:MediaElement x:Name="PreviewVideo" 
                              ShouldAutoPlay="True"
                              ShouldShowPlaybackControls="True"
                              HorizontalOptions="Fill" 
                              VerticalOptions="Fill" 
                              IsVisible="False" />

        <!-- Close Button -->
        <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#88000000" StrokeShape="RoundRectangle 20" StrokeThickness="0"
                HorizontalOptions="End" VerticalOptions="Start" Margin="20,40,20,20">
            <Path Data="{StaticResource IconClose}" Fill="White" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseTapped" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentPage>

